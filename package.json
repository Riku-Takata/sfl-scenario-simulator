{
  "name": "sfl-scenario-simulator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --port 3002",
    "build": "node scripts/write-build-info.mjs && astro build",
    "preview": "astro preview --port 3000 --host 0.0.0.0",
    "start": "node scripts/serve-static.mjs",
    "test": "node --import tsx --test tests/simulator.test.ts tests/match-recap.test.ts tests/recap-quality.test.ts tests/recap-writer-integration.test.ts tests/startgg.test.ts tests/sfl-play-style.test.ts tests/buckler.test.ts tests/encyclopedia-v2.test.ts tests/model.test.ts tests/youtube-archive.test.ts tests/fan-scoring.test.ts tests/fan-disclosure.test.ts tests/fan-collector.test.ts tests/fan-leakage.test.ts tests/fan-mdfromx.test.ts",
    "pipeline": "tsx scripts/run-pipeline.ts",
    "pipeline:force": "tsx scripts/run-pipeline.ts --force",
    "fetch-startgg": "tsx scripts/0a-fetch-startgg.ts",
    "resolve-startgg-identities": "tsx scripts/startgg/resolve-identities.ts",
    "fetch-sfl-play-stats": "tsx scripts/0b-fetch-sfl-play-stats.ts",
    "fetch-cpt": "tsx scripts/0-fetch-cpt-data.ts",
    "fetch-results": "tsx scripts/1-fetch-results.ts",
    "calc-scenarios": "tsx scripts/2-calc-scenarios.ts",
    "generate-narratives": "tsx scripts/3-generate-narratives.ts",
    "generate-recaps": "tsx scripts/4-generate-match-recaps.ts",
    "recap-worker": "tsx scripts/run-recap-worker.ts",
    "render-recaps": "tsx scripts/render-editorial-recaps.ts",
    "generate-tournaments": "tsx scripts/generate-sf6-tournaments.ts",
    "buckler:resolve-cfn": "tsx scripts/buckler/resolve-cfn-ids.ts",
    "buckler:sync": "tsx scripts/buckler/sync.ts",
    "buckler:aggregate": "tsx scripts/buckler/aggregate.ts"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.1",
    "@astrojs/sitemap": "^3.7.4",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^5.5.0",
    "html-to-image": "^1.11.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.12",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
