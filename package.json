{
  "name": "sfl-scenario-simulator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --port 3002",
    "build": "astro build",
    "preview": "astro preview --port 3000 --host 0.0.0.0",
    "start": "node scripts/serve-static.mjs",
    "test": "node --import tsx --test tests/simulator.test.ts",
    "pipeline": "tsx scripts/run-pipeline.ts",
    "pipeline:force": "tsx scripts/run-pipeline.ts --force",
    "fetch-cpt": "tsx scripts/0-fetch-cpt-data.ts",
    "fetch-results": "tsx scripts/1-fetch-results.ts",
    "calc-scenarios": "tsx scripts/2-calc-scenarios.ts",
    "generate-narratives": "tsx scripts/3-generate-narratives.ts",
    "generate-tournaments": "tsx scripts/generate-sf6-tournaments.ts"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.1",
    "@vercel/analytics": "^1.6.1",
    "astro": "^5.5.0",
    "html-to-image": "^1.11.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.12",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
