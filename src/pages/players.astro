---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PlayerEncyclopedia from "@/components/PlayerEncyclopedia";
import rawPlayerStats from "@/data/player-stats.json";
import rawMatches from "@/data/matches.json";
import rawCptMatchups from "@/data/cpt-matchups-top96.json";
import rawSf6Tournaments from "@/data/sf6-tournament-matchups.json";
import {
  CptMatchupsTop96DataSchema,
  MatchesDataSchema,
  PlayerStatsDataSchema,
  Sf6TournamentMatchupsDataSchema,
} from "@/lib/schema";
import { buildPlayerEncyclopedia } from "@/lib/player-encyclopedia";

const playerStatsData = PlayerStatsDataSchema.parse(rawPlayerStats);
const matchesData = MatchesDataSchema.parse(rawMatches);
const cptMatchupsData = CptMatchupsTop96DataSchema.parse(rawCptMatchups);
const sf6TournamentData =
  Sf6TournamentMatchupsDataSchema.parse(rawSf6Tournaments);

const players = buildPlayerEncyclopedia(
  playerStatsData,
  matchesData,
  cptMatchupsData,
  sf6TournamentData
);
---

<BaseLayout title="SFL 2026 選手図鑑・戦績パラメーター分析">
  <div class="page-intro">
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;">
      <div>
        <h1 class="page-title">SFL 2026 全48選手 データ図鑑・対キャラ相性分析</h1>
        <p class="page-desc">
          SFL公式戦および過去の公式大会の戦績データから算出した「各選手の6角形パラメーター」「起用傾向・特徴」「各キャラクターに対する相性・勝率データ」を網羅しています。
        </p>
      </div>
    </div>
  </div>

  <PlayerEncyclopedia client:load players={players} />
</BaseLayout>
