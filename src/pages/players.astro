---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PlayerEncyclopedia from "@/components/PlayerEncyclopedia";
import rawPlayerStats from "@/data/player-stats.json";
import rawMatches from "@/data/matches.json";
import rawCptMatchups from "@/data/cpt-matchups-top96.json";
import rawSf6Tournaments from "@/data/sf6-tournament-matchups.json";
import rawStartggResults from "@/data/startgg-premier-results.json";
import rawStartggIdentities from "@/data/startgg-identities.json";
import rawSflPlayStats from "@/data/sfl-play-stats.json";
import rawBucklerProfiles from "@/data/buckler-profiles.json";
import {
  BucklerProfilesDataSchema,
  CptMatchupsTop96DataSchema,
  MatchesDataSchema,
  PlayerStatsDataSchema,
  Sf6TournamentMatchupsDataSchema,
  StartggIdentitiesDataSchema,
  StartggPremierResultsDataSchema,
  SflPlayStatsDataSchema,
} from "@/lib/schema";
import { buildPlayerEncyclopedia } from "@/lib/player-encyclopedia";
import { buildTournamentProfiles } from "@/lib/startgg/profile";
import {
  buildPlayStyleProfiles,
  SFL_CURRENT_SEASON,
  SFL_PREVIOUS_SEASON,
} from "@/lib/sfl/play-style";
import { PLAYER_NAME_MAP } from "@/lib/simulator";

const playerStatsData = PlayerStatsDataSchema.parse(rawPlayerStats);
const matchesData = MatchesDataSchema.parse(rawMatches);
const cptMatchupsData = CptMatchupsTop96DataSchema.parse(rawCptMatchups);
const sf6TournamentData =
  Sf6TournamentMatchupsDataSchema.parse(rawSf6Tournaments);

const tournamentProfiles = buildTournamentProfiles(
  StartggPremierResultsDataSchema.parse(rawStartggResults),
  StartggIdentitiesDataSchema.parse(rawStartggIdentities),
  PLAYER_NAME_MAP
);

const playStyles = buildPlayStyleProfiles(
  SflPlayStatsDataSchema.parse(rawSflPlayStats),
  SFL_CURRENT_SEASON,
  SFL_PREVIOUS_SEASON
);

const players = buildPlayerEncyclopedia(
  playerStatsData,
  matchesData,
  cptMatchupsData,
  sf6TournamentData,
  tournamentProfiles,
  playStyles,
  BucklerProfilesDataSchema.parse(rawBucklerProfiles).players
);
---

<BaseLayout title="SFL 2026 選手図鑑・戦績パラメーター分析">
  <div class="page-intro">
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;">
      <div>
        <h1 class="page-title">SFL 2026 全48選手 データ図鑑・対キャラ相性分析</h1>
        <p class="page-desc">
          SFL公式戦の戦績と、start.ggに記録された直近1年のプレミア大会（CPT Premier / World Warrior / EVO 等）の実戦データから算出した「各選手の6角形パラメーター」「起用傾向・特徴」「各キャラクターに対する相性・勝率データ」を網羅しています。
        </p>
      </div>
    </div>
  </div>

  <PlayerEncyclopedia client:load players={players} />
</BaseLayout>
