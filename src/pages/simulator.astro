---
import BaseLayout from "@/layouts/BaseLayout.astro";
import InteractiveSimulator from "@/components/InteractiveSimulator";
import rawMatches from "@/data/matches.json";
import rawStandings from "@/data/standings.json";
import rawScenarios from "@/data/scenarios.json";
import {
  MatchesDataSchema,
  ScenariosDataSchema,
  StandingsDataSchema,
} from "@/lib/schema";

const matchesData = MatchesDataSchema.parse(rawMatches);
const standingsData = StandingsDataSchema.parse(rawStandings);
const scenariosData = ScenariosDataSchema.parse(rawScenarios);
---

<BaseLayout title="残り試合 順位シミュレーター | SFL 2026">
  <div class="page-intro">
    <h1 class="page-title">SFL 2026 残り試合 順位シミュレーター</h1>
    <p class="page-desc">
      未消化の試合にスコア（40-0 / 30-10 / 30-20）をクリックして入力すると、右側の順位表にリアルタイムで反映されます。
    </p>
  </div>

  <InteractiveSimulator
    client:load
    matchesData={matchesData}
    standingsData={standingsData}
    scenariosData={scenariosData}
  />
</BaseLayout>
