---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DivisionDashboard from "@/components/DivisionDashboard";
import rawStandings from "@/data/standings.json";
import rawMatches from "@/data/matches.json";
import rawScenarios from "@/data/scenarios.json";
import {
  MatchesDataSchema,
  ScenariosDataSchema,
  StandingsDataSchema,
} from "@/lib/schema";

const standingsData = StandingsDataSchema.parse(rawStandings);
const matchesData = MatchesDataSchema.parse(rawMatches);
const scenariosData = ScenariosDataSchema.parse(rawScenarios);
---

<BaseLayout title="SFL 2026 順位表・プレイオフ突破条件">
  <div class="page-intro">
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;">
      <div>
        <h1 class="page-title">SFL 2026 順位表・プレイオフ突破条件</h1>
        <p class="page-desc">
          ディビジョンごとの現在順位・プレイオフ進出確率（上位3チームが進出）と、各チームの突破条件・日程を確認できます。
        </p>
      </div>
      <a href="/simulator" class="btn btn-primary">
        残り試合のスコアを自分で入力して試算する →
      </a>
    </div>
  </div>

  <DivisionDashboard
    client:load
    standingsData={standingsData}
    matchesData={matchesData}
    scenariosData={scenariosData}
  />
</BaseLayout>
