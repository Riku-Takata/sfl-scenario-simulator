---
import BaseLayout from "@/layouts/BaseLayout.astro";
import rawStandings from "@/data/standings.json";
import rawMatches from "@/data/matches.json";
import rawScenarios from "@/data/scenarios.json";
import {
  MatchesDataSchema,
  ScenariosDataSchema,
  StandingsDataSchema,
} from "@/lib/schema";
import {
  PLAYER_NAME_MAP,
  TEAM_META_MAP,
} from "@/lib/simulator";

export function getStaticPaths() {
  return Object.values(TEAM_META_MAP).map((t) => ({
    params: { teamId: t.key },
  }));
}

const { teamId } = Astro.params;
const meta = teamId ? TEAM_META_MAP[teamId] : undefined;
if (!meta || !teamId) {
  return Astro.redirect("/");
}

const standingsData = StandingsDataSchema.parse(rawStandings);
const matchesData = MatchesDataSchema.parse(rawMatches);
const scenariosData = ScenariosDataSchema.parse(rawScenarios);

const analysis = scenariosData.teams[teamId];
const divStandings = standingsData.divisions[meta.division];
const currentStanding = divStandings.find((s) => s.key === teamId)!;

const teamMatches = matchesData.matches
  .filter((m) => m.home === teamId || m.away === teamId)
  .sort((a, b) => a.sectionNumber - b.sectionNumber);

const playedMatches = teamMatches.filter((m) => m.played);
const routeList = [
  analysis.routes.route1First,
  analysis.routes.route2Second,
  analysis.routes.route3Third,
];
---

<BaseLayout title={`${meta.name} のプレイオフ突破条件 | SFL 2026`}>
  <!-- 戻るリンク ＆ 同ディビジョン他チーム切り替え -->
  <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 1.25rem;">
    <a href="/" class="btn">
      ← 順位表へ戻る
    </a>

    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
      {divStandings.map((t) => (
        <a
          href={`/team/${t.key}`}
          class="score-chip"
          style={
            t.key === teamId
              ? "background: var(--text-main); color: #ffffff; border-color: var(--text-main);"
              : ""
          }
        >
          {t.rank}位 {t.shortName} ({t.point}pt)
        </a>
      ))}
    </div>
  </div>

  <!-- チーム概要ヘッダー -->
  <section
    class="page-intro"
    style={`border-left: 6px solid ${meta.color};`}
  >
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 1rem;">
      <div>
        <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.35rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem;">
          <span>Division {meta.division.toUpperCase()} — 現在 {currentStanding.rank}位 / 所属選手（図鑑）:</span>
          {meta.players.map((p) => (
            <a
              href={`/players?player=${p}`}
              class="score-chip"
              style="padding: 0.15rem 0.55rem; font-size: 0.78rem; color: var(--primary);"
            >
              {PLAYER_NAME_MAP[p] || p} →
            </a>
          ))}
        </div>
        <h1 class="page-title">{meta.name}</h1>
        <p class="page-desc">
          {analysis.statusSummary} {analysis.playoffOutlook}
        </p>
      </div>
    </div>

    <div class="grid-cards" style="margin-top: 1.25rem; margin-bottom: 0;">
      <div class="stat-card" style="background: var(--bg-subtle);">
        <div class="stat-label">現在順位・ポイント</div>
        <div class="stat-value">
          {currentStanding.rank}位 <span style="color: var(--primary);">{currentStanding.point}pt</span>
        </div>
        <div class="stat-sub">
          {currentStanding.victory}勝{currentStanding.entry - currentStanding.victory}敗（バトル得失{" "}
          {currentStanding.battleDiff > 0
            ? `+${currentStanding.battleDiff}`
            : currentStanding.battleDiff}）
        </div>
      </div>

      <div class="stat-card" style="background: var(--bg-subtle);">
        <div class="stat-label">プレイオフ進出率 (3位以内)</div>
        <div class="stat-value" style="color: var(--success);">
          {analysis.probabilities.playoffTop3.toFixed(1)}%
        </div>
        <div class="stat-sub">
          最大到達可能ポイント: {analysis.maxPossiblePoints}pt
        </div>
      </div>

      <div class="stat-card" style="background: var(--bg-subtle);">
        <div class="stat-label">2位以内確保率 (準決勝HOME権)</div>
        <div class="stat-value">
          {analysis.probabilities.top2HomeAdvantage.toFixed(1)}%
        </div>
        <div class="stat-sub">
          1位突破率: <strong>{analysis.probabilities.firstPlace.toFixed(1)}%</strong>
        </div>
      </div>

      <div class="stat-card" style="background: var(--bg-subtle);">
        <div class="stat-label">残り試合数</div>
        <div class="stat-value">
          残り {currentStanding.remainingMatches} 戦
        </div>
        <div class="stat-sub">
          HOME: {currentStanding.remainingHome}戦 / AWAY: {currentStanding.remainingAway}戦
        </div>
      </div>
    </div>
  </section>

  <!-- 1位〜3位 突破条件カード -->
  <h2 style="font-size: 1.25rem; font-weight: 800; margin: 1.5rem 0 0.85rem;">
    {meta.shortName} のプレイオフ突破条件（1位〜3位目安）
  </h2>

  <div class="scenario-grid">
    {routeList.map((route, i) => {
      const cardClass =
        i === 0
          ? "route-card route-1"
          : i === 1
            ? "route-card route-2"
            : "route-card route-3";

      return (
        <div class={cardClass}>
          <div style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.25rem;">
            {route.subtitle}
          </div>
          <h3>{route.title}</h3>

          <div
            style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; padding: 0.75rem; background: var(--bg-subtle); border: 1px solid var(--border-color); border-radius: 8px; margin: 0.75rem 0; font-size: 0.82rem;"
          >
            <div>
              <div style="color: var(--text-muted);">目標ポイント</div>
              <div style="font-weight: 800; font-size: 1.05rem; color: var(--primary);">
                {route.targetPoints}pt
              </div>
            </div>
            <div>
              <div style="color: var(--text-muted);">残り試合目安</div>
              <div style="font-weight: 800;">
                {route.requiredWins}勝{route.requiredLosses}敗
              </div>
            </div>
            <div>
              <div style="color: var(--text-muted);">達成確率</div>
              <div style="font-weight: 800;">{route.probability.toFixed(1)}%</div>
            </div>
          </div>

          <p style="font-size: 0.88rem; color: var(--text-sub); margin-bottom: 0.65rem;">
            {route.narrative}
          </p>

          <ul class="bullet-list">
            {route.keyConditions.map((cond) => (
              <li>{cond}</li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>

  <!-- 次節の他会場応援ガイド -->
  <div class="panel">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">
          次節の他会場カード：どちらを応援すると {meta.shortName} に有利か？
        </h2>
        <p style="font-size: 0.84rem; color: var(--text-muted); margin-top: 0.2rem;">
          同ディビジョンの他チームの試合で、{meta.shortName} のプレイオフ進出率が最も高くなる理想の結果です。
        </p>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem;">
      {analysis.nextSectionCheeringGuide.map((item) => (
        <div
          style="background: var(--bg-subtle); border: 1px solid var(--border-color); border-radius: 10px; padding: 1.15rem;"
        >
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-muted);">
              {item.sectionTitle}: {item.awayName} vs {item.homeName}
            </span>
            <span class="badge" style="background: var(--success-bg); color: var(--success);">
              進出率 +{item.playoffProbDelta.toFixed(1)}%
            </span>
          </div>

          <div style="font-size: 1.05rem; font-weight: 800; color: var(--primary); margin-bottom: 0.35rem;">
            {item.recommendedWinnerName} の勝利が有利（理想: {item.recommendedScoreLabel}）
          </div>
          <p style="font-size: 0.85rem; color: var(--text-sub);">
            {item.reason}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- 残り試合の目標星取表 -->
  {analysis.routes.route1First.targetSchedule &&
    analysis.routes.route1First.targetSchedule.length > 0 && (
      <div class="panel">
        <div class="panel-header">
          <div>
            <h2 class="panel-title">
              {meta.shortName} の残り試合日程 ＆ 1位突破に向けた目標スコア目安
            </h2>
          </div>
        </div>

        <div class="table-scroll">
          <table class="standings-table">
            <thead>
              <tr>
                <th>節</th>
                <th>日程</th>
                <th>対戦相手</th>
                <th>HOME / AWAY</th>
                <th>目標スコア目安</th>
                <th>ポイント</th>
              </tr>
            </thead>
            <tbody>
              {analysis.routes.route1First.targetSchedule.map((plan) => (
                <tr>
                  <td style="font-weight: 800;">{plan.sectionTitle}</td>
                  <td style="color: var(--text-muted); font-size: 0.85rem;">
                    {plan.scheduledAt.slice(0, 10)}
                  </td>
                  <td>
                    <a
                      href={`/team/${plan.opponentKey}`}
                      style="font-weight: 800; color: var(--primary);"
                    >
                      vs {plan.opponentName}
                    </a>
                  </td>
                  <td>
                    <span
                      class={`badge ${
                        plan.side === "home" ? "badge-home" : "badge-away"
                      }`}
                    >
                      {plan.side === "home" ? "HOME (後出し)" : "AWAY (先出し)"}
                    </span>
                  </td>
                  <td style="font-weight: 800;">
                    {plan.recommendedScore}（+{plan.teamPointGain}pt）
                  </td>
                  <td style="font-size: 0.85rem; color: var(--text-sub);">
                    {plan.note}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

  <!-- 消化済み試合の結果 -->
  <div class="panel">
    <div class="panel-header">
      <h2 class="panel-title">
        これまでの試合結果（{playedMatches.length}試合消化）
      </h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem;">
      {playedMatches.map((m) => {
        const isHome = m.home === teamId;
        const oppKey = isHome ? m.away : m.home;
        const oppMeta = TEAM_META_MAP[oppKey];
        const teamPt = isHome ? m.homePoint : m.awayPoint;
        const oppPt = isHome ? m.awayPoint : m.homePoint;
        const won = (isHome && m.winner === "home") || (!isHome && m.winner === "away");

        return (
          <div
            style="background: var(--bg-subtle); border: 1px solid var(--border-color); border-radius: 10px; padding: 1.1rem;"
          >
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.45rem;">
              <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 700;">
                {m.sectionTitle} ({m.scheduledAt.slice(0, 10)}) / {isHome ? "HOME" : "AWAY"}
              </span>
              <span
                class="badge"
                style={`background: ${won ? "var(--success-bg)" : "var(--danger-bg)"}; color: ${won ? "var(--success)" : "var(--danger)"};`}
              >
                {won ? "勝利" : "敗北"} {teamPt} - {oppPt}
              </span>
            </div>

            <div style="font-weight: 800; font-size: 0.96rem; margin-bottom: 0.5rem;">
              vs {oppMeta?.name ?? oppKey}
            </div>

            {m.bouts && (
              <div style="font-size: 0.8rem; color: var(--text-sub); border-top: 1px solid var(--border-color); padding-top: 0.5rem;">
                {m.bouts.map((b) => {
                  const myPlayer = isHome ? b.homePlayer : b.awayPlayer;
                  const oppPlayer = isHome ? b.awayPlayer : b.homePlayer;
                  const myBattle = isHome ? b.homeBattle : b.awayBattle;
                  const oppBattle = isHome ? b.awayBattle : b.homeBattle;
                  return (
                    <div
                      style="display: flex; justify-content: space-between; padding: 0.15rem 0;"
                    >
                      <span>
                        [{b.statusName}] {PLAYER_NAME_MAP[myPlayer] || myPlayer}
                      </span>
                      <strong>
                        {myBattle} - {oppBattle}
                      </strong>
                      <span>vs {PLAYER_NAME_MAP[oppPlayer] || oppPlayer}</span>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>
