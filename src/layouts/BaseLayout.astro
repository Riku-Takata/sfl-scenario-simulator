---
import "@/styles/globals.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { DONATION_CONFIG } from "@/config/donation";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "SFL 2026 順位・突破条件シミュレーター",
  description = "ストリートファイターリーグ: Pro-JP 2026 (Division S / Division F) の最新順位表・各チームのプレイオフ突破条件・残り試合の順位シミュレーター",
  image = "/ogp.png",
} = Astro.props;

const pathname = Astro.url.pathname;
const isSimulator = pathname.startsWith("/simulator");
const isPlayers = pathname.startsWith("/players");
const isRecap = pathname.startsWith("/recap");
const isAbout = pathname.startsWith("/about");
const isHome = !isSimulator && !isPlayers && !isRecap && !isAbout;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, "") : "https://sfl-scenario-simulator.vercel.app";
const canonicalURL = new URL(pathname, siteUrl).href;
const ogpImageURL = new URL(image, siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": `${siteUrl}/`,
      "name": "SFL 2026 順位・突破条件シミュレーター",
      "description": "ストリートファイターリーグ: Pro-JP 2026 の最新順位表・各チームのプレイオフ突破条件・残り試合シミュレーター",
      "inLanguage": "ja"
    },
    {
      "@type": "SportsEvent",
      "name": "ストリートファイターリーグ: Pro-JP 2026",
      "sport": "Street Fighter 6 eSports",
      "description": "国内最高峰のチームリーグ戦 SFL 2026 Pro-JP (Division S / Division F)"
    }
  ]
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="ストリートファイター6, SF6, SFL, SFL2026, ストリートファイターリーグ, 順位表, プレイオフ突破条件, シミュレーター, 選手相性, 勝率予想" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f172a" />

    <!-- Open Graph / OGP -->
    <meta property="og:site_name" content="SFL 2026 順位・突破条件シミュレーター" />
    <meta property="og:type" content={isHome ? "website" : "article"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogpImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogpImageURL} />

    <!-- 構造化データ (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-title">
          <span class="brand-mark">SFL 2026</span>
          <span>順位・突破条件シミュレーター</span>
        </a>

        <nav class="nav-links" aria-label="メインメニュー">
          <a href="/" class={`nav-btn ${isHome ? "active" : ""}`}>
            順位表・突破条件
          </a>
          <a href="/recap" class={`nav-btn ${isRecap ? "active" : ""}`}>
            試合結果・戦況レポート
          </a>
          <a href="/simulator" class={`nav-btn ${isSimulator ? "active" : ""}`}>
            残り試合シミュレーター
          </a>
          <a href="/players" class={`nav-btn ${isPlayers ? "active" : ""}`}>
            選手図鑑・相性分析
          </a>
          <a
            href={DONATION_CONFIG.bmcUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bmc-header-btn"
            title="開発者を支援する (Buy Me a Coffee)"
          >
            <span>☕</span>
            <span class="bmc-label">開発者を応援</span>
          </a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <strong>SFL 2026 順位・突破条件シミュレーター</strong> — レギュラーシーズン順位規定（①獲得ポイント → ②得失バトル差 → ③得失ラウンド差）対応
        </div>
        <div style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.85rem; margin: 0.5rem 0;">
          <a
            href={DONATION_CONFIG.bmcUrl}
            target="_blank"
            rel="noopener noreferrer"
            style="color: var(--primary); font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem;"
          >
            <span>☕</span>
            <span>開発者を支援する (Buy Me a Coffee)</span>
          </a>
          <span>・</span>
          <a
            href="/about"
            style="color: var(--text-sub); font-weight: 600; text-decoration: underline;"
          >
            サイトについて・規約・支援
          </a>
          <span>・</span>
          <span>永続無料ファンツール</span>
        </div>
        <div style="font-size: 0.75rem; color: var(--text-muted); line-height: 1.5;">
          ※当サイトは非公式のファンサイトであり、株式会社カプコン公式とは関係ありません。
        </div>
      </div>
    </footer>

    <!-- Buy Me a Coffee 公式ウィジェット -->
    <script
      is:inline
      data-name="BMC-Widget"
      data-cfasync="false"
      src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
      data-id="riku.chestnut"
      data-description="Support me on Buy me a coffee!"
      data-message="ご利用ありがとうございます！"
      data-color="#5F7FFF"
      data-position="Right"
      data-x_margin="18"
      data-y_margin="18"
    ></script>
  </body>
</html>
