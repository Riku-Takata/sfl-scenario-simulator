---
import "@/styles/globals.css";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SFL 2026 順位・突破条件シミュレーター",
  description = "ストリートファイターリーグ: Pro-JP 2026 (Division S / Division F) の最新順位表・各チームのプレイオフ突破条件・残り試合の順位シミュレーター",
} = Astro.props;

const pathname = Astro.url.pathname;
const isSimulator = pathname.startsWith("/simulator");
const isPlayers = pathname.startsWith("/players");
const isHome = !isSimulator && !isPlayers;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Analytics />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-title">
          <span class="brand-mark">SFL 2026</span>
          <span>順位・突破条件シミュレーター</span>
        </a>

        <nav class="nav-links" aria-label="メインメニュー">
          <a href="/" class={`nav-btn ${isHome ? "active" : ""}`}>
            順位表・突破条件
          </a>
          <a href="/simulator" class={`nav-btn ${isSimulator ? "active" : ""}`}>
            残り試合シミュレーター
          </a>
          <a href="/players" class={`nav-btn ${isPlayers ? "active" : ""}`}>
            選手図鑑・相性分析
          </a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <strong>SFL 2026 順位・突破条件シミュレーター</strong> — レギュラーシーズン順位規定（①獲得ポイント → ②得失バトル差 → ③得失ラウンド差）対応
        </div>
        <div style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1rem; margin: 0.5rem 0;">
          <a
            href="https://buymeacoffee.com/sfl_simulator"
            target="_blank"
            rel="noopener noreferrer"
            style="color: var(--primary); font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem;"
          >
            <span>☕</span>
            <span>開発者を支援する (Buy Me a Coffee)</span>
          </a>
          <span>・</span>
          <span>永続無料ファンツール</span>
        </div>
        <div style="font-size: 0.75rem; color: var(--text-muted); line-height: 1.5;">
          ※当サイトは非公式のファンサイトであり、株式会社カプコン公式とは関係ありません。<br />
          ※掲載されている一部リンクにはアフィリエイト広告（PR）が含まれており、適法に運営されています。
        </div>
      </div>
    </footer>
  </body>
</html>
