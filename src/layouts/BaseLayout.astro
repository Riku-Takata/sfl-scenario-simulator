---
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SFL 2026 順位・突破条件シミュレーター",
  description = "ストリートファイターリーグ: Pro-JP 2026 (Division S / Division F) の最新順位表・各チームのプレイオフ突破条件・残り試合の順位シミュレーター",
} = Astro.props;

const pathname = Astro.url.pathname;
const isSimulator = pathname.startsWith("/simulator");
const isHome = !isSimulator;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-title">
          <span class="brand-mark">SFL 2026</span>
          <span>順位・突破条件シミュレーター</span>
        </a>

        <nav class="nav-links" aria-label="メインメニュー">
          <a href="/" class={`nav-btn ${isHome ? "active" : ""}`}>
            順位表・突破条件
          </a>
          <a href="/simulator" class={`nav-btn ${isSimulator ? "active" : ""}`}>
            残り試合シミュレーター
          </a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <strong>SFL 2026 順位・突破条件シミュレーター</strong> — レギュラーシーズン順位規定（①獲得ポイント → ②得失バトル差 → ③得失ラウンド差）対応
        </div>
        <div>
          ※当サイトは非公式のファンサイトであり、株式会社カプコン公式とは関係ありません。
        </div>
      </div>
    </footer>
  </body>
</html>
