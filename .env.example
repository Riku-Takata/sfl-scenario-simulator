# SFL 2026 公式APIエンドポイント (既定値で動作します)
SFL_API_RESULTS_URL=https://sf.esports.capcom.com/api/sfl2026/?data=results
SFL_API_STATS_URL=https://sf.esports.capcom.com/api/sfl2026/?data=stats

# start.gg GraphQL API トークン (設定時は直近1年のプレミア大会の実戦を差分取得。未設定時は保存済みの src/data/startgg-premier-results.json を使用)
STARTGG_API_TOKEN=
STARTGG_API_URL=https://api.start.gg/gql/alpha

# Buckler's Boot Camp のセッション Cookie (自宅サーバーの日次同期のみで使用。GitHub Actions には設定しない)
# ブラウザでログインした状態の Cookie ヘッダー全体 (buckler_id=...; buckler_r_id=...; ...) を1行で設定する
BUCKLER_AUTH_COOKIE=
# 蓄積データの保存先 (既定: D:\HomeServer\data\app-data\sfl-buckler)
# BUCKLER_DATA_DIR=

# LLM生成設定 (agy CLI / Gemini API / フォールバックの順で自動選択)
AGY_BIN=agy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ファン応援指数 (自宅サーバーのみ)
# Flovia の API キー (https://flovia.dev/)。リポジトリ・ログに出さない
FLOVIA_KEY=
# FLOVIA_MCP_URL=https://api.flovia.dev/mcp
# 著者IDの HMAC 鍵 (32文字以上のランダム値。シーズンごとに作り直し、旧鍵は破棄する)
AUTHOR_HMAC_SECRET=
# ローカルDB・評価結果の置き場所 (既定: ../../data/app-data/sfl-fan-engagement)
# FAN_DATA_DIR=
# BUDGET_STOP_PCT_5H=70
# BUDGET_STOP_PCT_WEEK=60
# MAX_CALLS_PER_RUN=12
# MAX_PAGES_PER_TEAM_PER_RUN=3
